{
  "name": "@constantant/openapi-resource-gen",
  "version": "1.14.0",
  "description": "Nx generator: OpenAPI 3.x and Swagger 2.0 to a tree-shakeable Angular API client, one InjectionToken per endpoint via httpResource or HttpClient",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/constantant/angular-openapi-gen.git",
    "directory": "tools/openapi-resource-gen"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "generators": "./generators.json",
  "executors": "./executors.json",
  "keywords": [
    "angular",
    "angular-signals",
    "nx",
    "nx-plugin",
    "nx-generator",
    "openapi",
    "openapi3",
    "swagger",
    "swagger2",
    "openapi-generator",
    "openapi-typescript",
    "api-client",
    "codegen",
    "code-generator",
    "typescript",
    "httpResource",
    "http-resource",
    "httpclient",
    "signals",
    "InjectionToken",
    "tree-shaking",
    "rest"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@nx/devkit": ">=20.0.0",
    "nx": ">=20.0.0"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@scalar/openapi-upgrader": "^0.4.1",
    "js-yaml": "^5.4.2",
    "openapi-types": "^12.1.3",
    "openapi-typescript": "^7.13.0",
    "tslib": "^2.3.0"
  },
  "homepage": "https://github.com/constantant/angular-openapi-gen/tree/master/tools/openapi-resource-gen#readme",
  "bugs": {
    "url": "https://github.com/constantant/angular-openapi-gen/issues"
  }
}
