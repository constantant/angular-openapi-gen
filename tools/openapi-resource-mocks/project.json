{
  "name": "openapi-resource-mocks",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/openapi-resource-mocks/src",
  "projectType": "library",
  "tags": ["scope:tools", "type:mocks"],
  "targets": {
    "build-lib": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/tools/openapi-resource-mocks",
        "main": "tools/openapi-resource-mocks/src/index.ts",
        "tsConfig": "tools/openapi-resource-mocks/tsconfig.lib.json",
        "assets": [
          {
            "input": "tools/openapi-resource-mocks",
            "glob": "package.json",
            "output": "."
          },
          {
            "input": "tools/openapi-resource-mocks",
            "glob": "README.md",
            "output": "."
          },
          {
            "input": "tools/openapi-resource-mocks",
            "glob": "CHANGELOG.md",
            "output": "."
          }
        ]
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-lib"],
      "outputs": [
        "{workspaceRoot}/dist/tools/openapi-resource-mocks/src/runtime.global.js"
      ],
      "options": {
        "command": "node tools/openapi-resource-mocks/scripts/bundle-runtime.mjs",
        "cwd": "{workspaceRoot}"
      },
      "metadata": {
        "description": "Builds the package (build-lib), then bundles the runtime script the Playwright helper loads into pages."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run --config tools/openapi-resource-mocks/vitest.config.ts",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
