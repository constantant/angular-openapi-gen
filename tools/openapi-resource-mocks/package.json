{
  "name": "@constantant/openapi-resource-mocks",
  "version": "1.13.0",
  "description": "Mocks and test helpers for @constantant/openapi-resource-gen tokens: unit tests, Playwright E2E and a Chrome DevTools panel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/constantant/angular-openapi-gen.git",
    "directory": "tools/openapi-resource-mocks"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./testing": {
      "types": "./src/testing.d.ts",
      "default": "./src/testing.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@angular/common": ">=20.0.0",
    "@angular/core": ">=20.0.0",
    "rxjs": "^7.8.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "keywords": [
    "angular",
    "angular-testing",
    "testing",
    "mock",
    "mocking",
    "msw",
    "openapi",
    "httpResource",
    "http-resource",
    "InjectionToken",
    "signals",
    "e2e",
    "playwright",
    "vitest",
    "devtools",
    "chrome-extension"
  ],
  "homepage": "https://github.com/constantant/angular-openapi-gen/tree/master/tools/openapi-resource-mocks#readme",
  "bugs": {
    "url": "https://github.com/constantant/angular-openapi-gen/issues"
  }
}
