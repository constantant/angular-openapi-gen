{
  "name": "@org/stackblitz-example",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build:api": "tsc -p apps/api/tsconfig.cli.json",
    "export-openapi": "npm run build:api && node dist/apps/api/main.js --export-openapi=specs/api.openapi.json",
    "generate": "npm run export-openapi && openapi-resource-gen specs/api.openapi.json --outputDir libs/tasks-data-access/src --baseUrlToken TASKS_BASE_URL",
    "start:api": "npm run build:api && node dist/apps/api/main.js",
    "start:web": "ng serve",
    "start": "npm run generate && concurrently -k -n api,web \"npm:start:api\" \"npm:start:web\""
  },
  "private": true,
  "devDependencies": {
    "@angular-devkit/core": "~22.1.0",
    "@angular-devkit/schematics": "~22.1.0",
    "@angular/build": "~22.1.0",
    "@angular/cli": "~22.1.0",
    "@angular/compiler-cli": "~22.1.0",
    "@angular/language-service": "~22.1.0",
    "@constantant/openapi-resource-gen": "^2.1.0",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/testing": "^11.0.0",
    "@nx/angular": "^23.3.0",
    "@nx/eslint": "^23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "^23.3.0",
    "@nx/nest": "^23.3.0",
    "@nx/node": "23.3.0",
    "@nx/web": "23.3.0",
    "@nx/webpack": "23.3.0",
    "@schematics/angular": "~22.1.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "^24.0.0",
    "@typescript-eslint/utils": "^8.58.0",
    "angular-eslint": "^22.1.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "nx": "^23.3.0",
    "prettier": "^3.8.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "webpack": "~5.110.0",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "dependencies": {
    "@angular/common": "~22.1.0",
    "@angular/compiler": "~22.1.0",
    "@angular/core": "~22.1.0",
    "@angular/forms": "~22.1.0",
    "@angular/platform-browser": "~22.1.0",
    "@angular/router": "~22.1.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  }
}
